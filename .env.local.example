# Copy this file to .env.local and fill in the values.
#
# Local dev (after `supabase start`): run `npx supabase status` and copy the
# "API URL", "anon key", and "service_role key" values below.
# Production: copy these from your Supabase project's Settings > API page,
# and set the same variables in Vercel's Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FantasyPros: rankings/projections sync uses the public partner feed
# (no API key required). FANTASYPROS_API_KEY is optional / unused for sync.
# FANTASYPROS_API_KEY=

# Optional server default for allowlisted accounts only (see lib/agent/server-llm.ts).
# Everyone else still uses BYOK in the browser UI (localStorage).
# OPENAI_API_KEY=
# Ollama only works when next dev can reach http://127.0.0.1:11434 on your machine.
