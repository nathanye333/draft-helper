# Copy this file to .env.local and fill in the values.
#
# Local dev (after `supabase start`): run `npx supabase status` and copy the
# "API URL", "anon key", and "service_role key" values below.
# Production: copy these from your Supabase project's Settings > API page,
# and set the same variables in Vercel's Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (local Supabase Auth). Create a Web client in Google Cloud Console,
# set Authorized redirect URI to http://127.0.0.1:54321/auth/v1/callback, then
# put the client ID/secret here before `npx supabase start`.
# Production: enable Google under Authentication → Providers in the Supabase dashboard
# (do not put secrets in Vercel for that — only in Supabase Auth settings).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# FantasyPros: rankings/projections sync uses the public partner feed
# (no API key required). FANTASYPROS_API_KEY is optional / unused for sync.
# FANTASYPROS_API_KEY=

# Optional server default for allowlisted accounts only (see lib/agent/server-llm.ts).
# Tied to the signed-in user's email (works with Google OAuth for that address).
# Everyone else still uses BYOK in the browser UI (localStorage).
# OPENAI_API_KEY=
# Ollama only works when next dev can reach http://127.0.0.1:11434 on your machine.

# Optional: encrypt ESPN cookies at rest (defaults to hashing SUPABASE_SERVICE_ROLE_KEY).
# ESPN_COOKIE_ENCRYPTION_KEY=

# Optional: Brave Search API key for reliable draft-agent web_search (news/injuries).
# Without it, the agent uses Google/Bing news RSS + DuckDuckGo Instant Answer JSON
# (no HTML scraping — DDG HTML often blocks Vercel/cloud IPs as bots).
# Get a key at https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
