# Copy this file to .env.local and fill in the values.
#
# Local dev (after `supabase start`): run `npx supabase status` and copy the
# "API URL", "anon key", and "service_role key" values below.
# Production: copy these from your Supabase project's Settings > API page,
# and set the same variables in Vercel's Project Settings > Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# FantasyPros API key (server-only, never exposed to the client).
# Sign up for API access at https://www.fantasypros.com/api-data/
FANTASYPROS_API_KEY=
